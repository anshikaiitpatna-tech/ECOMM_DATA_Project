
DROP TABLE IF EXISTS ecommerce_orders CASCADE;

CREATE TABLE ecommerce_orders (
    order_id            VARCHAR(50) NOT NULL,
    order_date          DATE NOT NULL,
    ship_date           DATE,
    ship_mode           VARCHAR(50),
    customer_id         VARCHAR(50) NOT NULL,
    customer_name       VARCHAR(100),
    segment             VARCHAR(50),
    city                VARCHAR(100),
    state               VARCHAR(100),
    country             VARCHAR(100),
    postal_code         VARCHAR(20),
    market              VARCHAR(50),
    region              VARCHAR(50),
    product_id          VARCHAR(50) NOT NULL,
    category            VARCHAR(50),
    sub_category        VARCHAR(50),
    product_name        TEXT,
    sales               NUMERIC(12, 4),
    quantity            INT,
    discount            NUMERIC(5, 4),
    profit              NUMERIC(12, 4),
    shipping_cost       NUMERIC(12, 4),
    order_priority      VARCHAR(20),
    year                INT,
    PRIMARY KEY (order_id, product_id)
);


CREATE INDEX idx_orders_order_date ON ecommerce_orders(order_date);
CREATE INDEX idx_orders_customer   ON ecommerce_orders(customer_id);
CREATE INDEX idx_orders_product    ON ecommerce_orders(product_id);
CREATE INDEX idx_orders_market     ON ecommerce_orders(market, region);



SELECT 
    COUNT(DISTINCT order_id)                     AS total_orders,
    COUNT(DISTINCT customer_id)                  AS unique_customers,
    SUM(quantity)                                AS total_units_sold,
    ROUND(SUM(sales), 2)                         AS total_revenue,
    ROUND(SUM(profit), 2)                        AS total_profit,
    ROUND((SUM(profit) / SUM(sales)) * 100, 2)   AS profit_margin_pct,
    ROUND(AVG(sales), 2)                         AS avg_order_value (AOV)
FROM ecommerce_orders;



WITH monthly_sales AS (
    SELECT 
        DATE_TRUNC('month', order_date) AS sales_month,
        ROUND(SUM(sales), 2)            AS current_month_sales,
        ROUND(SUM(profit), 2)           AS current_month_profit
    FROM ecommerce_orders
    GROUP BY DATE_TRUNC('month', order_date)
)
SELECT 
    sales_month,
    current_month_sales,
    current_month_profit,
    LAG(current_month_sales) OVER (ORDER BY sales_month) AS previous_month_sales,
    ROUND(
        (current_month_sales - LAG(current_month_sales) OVER (ORDER BY sales_month)) 
        / NULLIF(LAG(current_month_sales) OVER (ORDER BY sales_month), 0) * 100, 2
    ) AS mom_growth_pct
FROM monthly_sales
ORDER BY sales_month;

SELECT 
    year,
    COUNT(DISTINCT order_id)                   AS total_orders,
    ROUND(SUM(sales), 2)                       AS annual_revenue,
    ROUND(SUM(profit), 2)                      AS annual_profit,
    ROUND(AVG(discount) * 100, 2)              AS avg_discount_given_pct
FROM ecommerce_orders
GROUP BY year
ORDER BY year;


WITH rfm_base AS (
    SELECT 
        customer_id,
        customer_name,
        MAX(order_date)                                         AS last_order_date,
        (SELECT MAX(order_date) FROM ecommerce_orders) - MAX(order_date) AS recency_days,
        COUNT(DISTINCT order_id)                                AS frequency,
        ROUND(SUM(sales), 2)                                    AS monetary_value
    FROM ecommerce_orders
    GROUP BY customer_id, customer_name
),
rfm_scores AS (
    SELECT 
        *,
        NTILE(5) OVER (ORDER BY recency_days DESC)  AS r_score,
        NTILE(5) OVER (ORDER BY frequency ASC)      AS f_score,
        NTILE(5) OVER (ORDER BY monetary_value ASC) AS m_score
    FROM rfm_base
)
SELECT 
    customer_id,
    customer_name,
    recency_days,
    frequency,
    monetary_value,
    (r_score + f_score + m_score) AS overall_rfm_score,
    CASE 
        WHEN (r_score + f_score + m_score) >= 13 THEN 'Champions / VIP'
        WHEN (r_score + f_score + m_score) >= 10 THEN 'Loyal Customers'
        WHEN (r_score + f_score + m_score) >= 7  THEN 'At Risk'
        ELSE 'Churn Warning / Needs Attention'
    END AS customer_segment
FROM rfm_scores
ORDER BY monetary_value DESC
LIMIT 20;



WITH product_sales AS (
    SELECT 
        product_name,
        category,
        ROUND(SUM(sales), 2) AS total_sales
    FROM ecommerce_orders
    GROUP BY product_name, category
),
running_sales AS (
    SELECT 
        product_name,
        category,
        total_sales,
        SUM(total_sales) OVER (ORDER BY total_sales DESC) AS cumulative_sales,
        SUM(total_sales) OVER ()                           AS grand_total_sales
    FROM product_sales
)
SELECT 
    product_name,
    category,
    total_sales,
    ROUND((cumulative_sales / grand_total_sales) * 100, 2) AS cumulative_revenue_pct,
    CASE 
        WHEN (cumulative_sales / grand_total_sales) <= 0.80 THEN 'Top 80% Driver'
        ELSE 'Bottom 20% Long Tail'
    END AS pareto_class
FROM running_sales
ORDER BY total_sales DESC;

SELECT 
    category,
    sub_category,
    COUNT(order_id)                                              AS total_items_sold,
    ROUND(AVG(discount) * 100, 2)                                AS avg_discount_pct,
    ROUND(SUM(sales), 2)                                         AS total_sales,
    ROUND(SUM(profit), 2)                                        AS total_profit,
    ROUND(SUM(CASE WHEN profit < 0 THEN profit ELSE 0 END), 2)   AS total_loss_amount
FROM ecommerce_orders
GROUP BY category, sub_category
HAVING SUM(profit) < 0 OR AVG(discount) > 0.20
ORDER BY total_loss_amount ASC;


SELECT 
    ship_mode,
    order_priority,
    COUNT(order_id)                                                     AS total_shipments,
    ROUND(AVG(ship_date - order_date), 2)                              AS avg_shipping_days,
    ROUND(AVG(shipping_cost), 2)                                        AS avg_shipping_cost,
    SUM(CASE WHEN (ship_date - order_date) > 5 THEN 1 ELSE 0 END)       AS delayed_shipments_cnt,
    ROUND(
        (SUM(CASE WHEN (ship_date - order_date) > 5 THEN 1 ELSE 0 END)::NUMERIC / COUNT(order_id)) * 100, 2
    ) AS delay_rate_pct
FROM ecommerce_orders
WHERE ship_date IS NOT NULL
GROUP BY ship_mode, order_priority
ORDER BY avg_shipping_days DESC;


WITH market_regional_ranking AS (
    SELECT 
        market,
        region,
        ROUND(SUM(sales), 2)  AS total_sales,
        ROUND(SUM(profit), 2) AS total_profit,
        DENSE_RANK() OVER (PARTITION BY market ORDER BY SUM(sales) DESC) AS rank_in_market
    FROM ecommerce_orders
    GROUP BY market, region
)
SELECT 
    market,
    region,
    total_sales,
    total_profit,
    rank_in_market
FROM market_regional_ranking
WHERE rank_in_market = 1
ORDER BY total_sales DESC;
